# S001-NFR-005 Phase 1.5 — single-origin reverse proxy.
#
# This file is processed by the nginxinc/nginx-unprivileged image's docker-entrypoint
# at container start: every file in /etc/nginx/templates/*.template is run through
# envsubst and written to /etc/nginx/conf.d/<basename>.conf.
#
# envsubst only substitutes variables that exist in the container's environment;
# nginx's own runtime variables ($host, $http_upgrade, $remote_addr, etc.) are
# NOT env vars and pass through unchanged.
#
# Required env vars (with image-baked defaults: BACKEND_HOST=backend, BACKEND_PORT=8000):
#   - BACKEND_HOST  the DNS name (Docker service-name DNS or k8s Service DNS) of the backend
#   - BACKEND_PORT  the backend port (FastAPI uvicorn)

# WebSocket upgrade map (must be at http level — conf.d is included inside http block).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend {
    server ${BACKEND_HOST}:${BACKEND_PORT};
    keepalive 16;
}

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # gzip on text/JSON/JS — saves ~70% on the SPA bundle. nginx-tree module, no extra deps.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss text/javascript;

    # SPA fallback — any unmatched path returns index.html so React Router can handle routing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # HTTP API proxy — backend's FastAPI routers under /api/*
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
    }

    # WebSocket proxy — chat endpoint /ws/chat/{case_id}
    # Long timeout so cold-loaded LLM responses don't get killed mid-stream.
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Backend StaticFiles mount — source PDFs (root_docs/)
    # Without this block, the SPA fallback above would swallow these requests.
    location /root_docs/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Backend StaticFiles mount — case PDFs (DOCUMENTS_PATH)
    location /documents/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
